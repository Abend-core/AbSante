# Image de production du front : build statique servi par nginx (le Dockerfile voisin
# lance le serveur de développement Vite, il ne sert qu'au docker-compose de dev).
FROM node:22-alpine AS build
WORKDIR /app
# Le Raspberry Pi n'a que 4 Go de RAM pour ~20 conteneurs : on plafonne Node.
ENV NODE_OPTIONS=--max-old-space-size=1024
COPY package*.json ./
RUN npm ci
COPY . .
# `vite build` seul : le typecheck et les tests tournent déjà dans la CI.
RUN npx vite build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
